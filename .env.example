# ─────────────────────────────────────────────────────────
# InsightApex — Environment Variables
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────
# Local example: postgresql://postgres:password@localhost:5432/insightapex
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/insightapex?schema=public"

# ── Auth.js (NextAuth) ────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-random-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# ── Email (Resend) ────────────────────────────────────────
# Leave blank in dev — emails will be logged to the console instead.
# Sign up at https://resend.com and add a verified domain.
RESEND_API_KEY=""
EMAIL_FROM="InsightApex <no-reply@insightapex.com>"

# ── File Storage (Cloudflare R2) ──────────────────────────
# Needed only when uploading question images or certificates.
# R2 is S3-compatible; use the @aws-sdk/client-s3 package.
R2_ENDPOINT=""              # https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="insightapex"
R2_PUBLIC_BASE_URL=""       # e.g. https://cdn.insightapex.com

# ── Payments (Phase 2 — not used yet) ────────────────────
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
