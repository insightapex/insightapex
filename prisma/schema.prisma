// InsightApex - Prisma Schema (Phase 1)
// Designed so Phase 2/3 features (payments, AI, certificates) can be
// added by extending existing models rather than rewriting them.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------------------

enum Role {
  STUDENT
  ADMIN
}

enum DifficultyLevel {
  EASY
  MEDIUM
  HARD
}

enum AccessLevel {
  FREE
  PREMIUM // TODO Phase 2: gate premium content behind purchase/subscription
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  ABANDONED
}

// Phase 2/3 placeholder enums (not used yet, kept here so schema does not
// need restructuring later)
enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  TRIALING
}

enum PurchaseType {
  PAPER_PACK
  QUESTION_PACK
  SUBSCRIPTION
  MOCK_EXAM
  ONE_TIME_PAPER
  ONE_TIME_MOCK_EXAM
}

enum MockExamStatus {
  DRAFT
  PUBLISHED
}

enum BillingAccessType {
  FREE
  MONTHLY_SUBSCRIPTION
  YEARLY_SUBSCRIPTION
  ONE_TIME_PAPER
  ONE_TIME_MOCK_EXAM
  ADMIN_GRANTED
}

enum PlanBillingInterval {
  MONTHLY
  YEARLY
  ONE_TIME
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  CANCELED
}

enum ProductType {
  SUBSCRIPTION_PLAN
  PAPER
  MOCK_EXAM
  QUESTION_PACK
}

enum UserAccessStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

// ---------------------------------------------------------------------------
// USERS & AUTH
// ---------------------------------------------------------------------------

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  passwordHash  String
  role          Role     @default(STUDENT)
  emailVerified DateTime?
  image         String?
  stripeCustomerId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Auth support structures
  verificationTokens VerificationToken[]
  passwordResetTokens PasswordResetToken[]
  sessions      Session[]

  // Student domain data
  attempts      QuizAttempt[]
  profile       StudentProfile?

  // Phase 2/3 placeholders — left empty/unused in Phase 1
  subscriptions Subscription[]
  purchases     Purchase[]
  payments      Payment[]
  userAccess    UserAccess[]
  certificates  Certificate[]

  @@index([email])
  @@index([stripeCustomerId])
}

model StudentProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio         String?
  targetExamDate DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Verification + password reset tokens (Resend-ready: token is emailed,
// consumed once). Kept generic so they work for any email provider.
model VerificationToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

// Auth.js session/account tables (kept minimal; JWT strategy is default,
// but DB session table is included for future flexibility)
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime
}

// ---------------------------------------------------------------------------
// ACCA CONTENT STRUCTURE
// ---------------------------------------------------------------------------

model Paper {
  id          String   @id @default(cuid())
  code        String   @unique // e.g. "FA1", "PM", "SBR"
  title       String
  description String?
  accessLevel AccessLevel @default(FREE) // TODO Phase 2: PREMIUM papers require purchase/subscription
  isPremium   Boolean  @default(false)
  priceCents  Int?
  currency    String?  @default("USD")
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  topics      Topic[]
  attempts    QuizAttempt[]
  mockExams   MockExam[]

  // Phase 2 placeholder: paper-specific purchase packs
  purchases   Purchase[]
  products    Product[]
  userAccess  UserAccess[]
}

model Topic {
  id          String   @id @default(cuid())
  paperId     String
  paper       Paper    @relation(fields: [paperId], references: [id], onDelete: Cascade)
  title       String
  description String?
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  questions   Question[]

  @@index([paperId])
}

model Question {
  id            String   @id @default(cuid())
  topicId       String
  topic         Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  text          String
  explanation   String?
  difficulty    DifficultyLevel @default(MEDIUM)
  marks         Int      @default(1)
  imageUrl      String?  // Cloudflare R2-ready: stores public object URL
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  options       AnswerOption[]
  responses     QuestionResponse[]
  mockExamLinks MockExamQuestion[]

  @@index([topicId])
}

model AnswerOption {
  id          String   @id @default(cuid())
  questionId  String
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text        String
  isCorrect   Boolean  @default(false)
  order       Int      @default(0)

  responses   QuestionResponse[]

  @@index([questionId])
}

// ---------------------------------------------------------------------------
// QUIZ ATTEMPTS & RESULTS
// ---------------------------------------------------------------------------

model QuizAttempt {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  paperId      String
  paper        Paper    @relation(fields: [paperId], references: [id])
  mockExamId   String?
  mockExam     MockExam? @relation(fields: [mockExamId], references: [id], onDelete: SetNull)
  status       AttemptStatus @default(IN_PROGRESS)
  startedAt    DateTime @default(now())
  submittedAt  DateTime?
  durationSec  Int?     // timer support
  totalQuestions Int    @default(0)
  correctCount Int      @default(0)
  wrongCount   Int      @default(0)
  scorePercent Float?
  passed       Boolean?

  responses    QuestionResponse[]

  // Phase 3 placeholder
  certificate  Certificate?

  @@index([userId])
  @@index([paperId])
  @@index([mockExamId])
}

// ---------------------------------------------------------------------------
// MOCK EXAMS (admin-defined question sets — distinct from random practice)
// ---------------------------------------------------------------------------

model MockExam {
  id              String         @id @default(cuid())
  paperId         String
  paper           Paper          @relation(fields: [paperId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  durationMinutes Int            @default(40)
  passMarkPercent Float          @default(50)
  order           Int            @default(0)
  status          MockExamStatus @default(DRAFT)
  accessLevel     AccessLevel    @default(FREE)
  isPremium       Boolean        @default(false)
  priceCents      Int?
  currency        String?        @default("USD")
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  questions       MockExamQuestion[]
  attempts        QuizAttempt[]
  purchases       Purchase[]
  products        Product[]
  userAccess      UserAccess[]

  @@index([paperId])
  @@index([status, isActive])
}

model MockExamQuestion {
  id         String   @id @default(cuid())
  mockExamId String
  mockExam   MockExam @relation(fields: [mockExamId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  order      Int      @default(0)

  @@unique([mockExamId, questionId])
  @@index([mockExamId])
  @@index([questionId])
}

model QuestionResponse {
  id              String   @id @default(cuid())
  attemptId       String
  attempt         QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId      String
  question        Question @relation(fields: [questionId], references: [id])
  selectedOptionId String?
  selectedOption  AnswerOption? @relation(fields: [selectedOptionId], references: [id])
  isCorrect       Boolean  @default(false)
  markedForReview Boolean  @default(false)
  answeredAt      DateTime?

  @@index([attemptId])
  @@index([questionId])
}

// ---------------------------------------------------------------------------
// PHASE 2/3 BILLING & ACCESS (structure only — no payment UI in Phase 1)
// ---------------------------------------------------------------------------

model Plan {
  id                   String              @id @default(cuid())
  name                 String
  slug                 String              @unique
  description          String?
  accessType           BillingAccessType
  priceCents           Int
  currency             String              @default("GBP")
  billingInterval      PlanBillingInterval
  features             String[]            @default([])
  isActive             Boolean             @default(true)
  provider             String?
  providerProductId    String?
  providerPriceId      String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  subscriptions        Subscription[]
  products             Product[]
}

model Product {
  id              String            @id @default(cuid())
  name            String
  slug            String            @unique
  description     String?
  type            ProductType
  accessType      BillingAccessType @default(FREE)
  isPremium       Boolean           @default(false)
  priceCents      Int?
  currency        String?           @default("GBP")
  isActive        Boolean           @default(true)
  planId          String?
  plan            Plan?             @relation(fields: [planId], references: [id], onDelete: SetNull)
  paperId         String?
  paper           Paper?            @relation(fields: [paperId], references: [id], onDelete: SetNull)
  mockExamId      String?
  mockExam        MockExam?         @relation(fields: [mockExamId], references: [id], onDelete: SetNull)
  provider        String?
  providerProductId String?
  providerPriceId String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  purchases       Purchase[]
}

model Subscription {
  id                     String             @id @default(cuid())
  userId                 String
  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId                 String?
  plan                   Plan?              @relation(fields: [planId], references: [id], onDelete: SetNull)
  status                 SubscriptionStatus
  accessType             BillingAccessType  @default(MONTHLY_SUBSCRIPTION)
  priceCents             Int?
  currency               String?            @default("GBP")
  startsAt               DateTime?
  endsAt                 DateTime?
  provider               String?
  providerCustomerId     String?
  providerSubscriptionId String?
  stripeCustomerId       String?
  stripeSubscriptionId   String?
  currentPeriodEnd       DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  payments               Payment[]
  userAccess             UserAccess[]

  @@index([userId])
  @@index([stripeSubscriptionId])
  @@index([stripeCustomerId])
}

model Purchase {
  id                String            @id @default(cuid())
  userId            String
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId         String?
  product           Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)
  type              PurchaseType
  accessType        BillingAccessType @default(FREE)
  paperId           String?
  paper             Paper?            @relation(fields: [paperId], references: [id], onDelete: SetNull)
  mockExamId        String?
  mockExam          MockExam?         @relation(fields: [mockExamId], references: [id], onDelete: SetNull)
  status            PaymentStatus     @default(PENDING)
  amountCents       Int?
  currency          String?           @default("GBP")
  provider          String?
  providerPaymentId String?
  stripePaymentId   String?
  startsAt          DateTime?
  endsAt            DateTime?
  createdAt         DateTime          @default(now())

  payments          Payment[]
  userAccess        UserAccess[]

  @@index([userId])
  @@index([stripePaymentId])
  @@index([status])
}

model Payment {
  id                String         @id @default(cuid())
  userId            String
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  purchaseId        String?
  purchase          Purchase?      @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  subscriptionId    String?
  subscription      Subscription?  @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  amountCents       Int
  currency          String         @default("GBP")
  status            PaymentStatus  @default(PENDING)
  provider          String?
  providerPaymentId String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([userId])
}

model UserAccess {
  id             String            @id @default(cuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessType     BillingAccessType @default(FREE)
  paperId        String?
  paper          Paper?            @relation(fields: [paperId], references: [id], onDelete: Cascade)
  mockExamId     String?
  mockExam       MockExam?         @relation(fields: [mockExamId], references: [id], onDelete: Cascade)
  questionId     String?
  status         UserAccessStatus  @default(ACTIVE)
  startsAt       DateTime?
  endsAt         DateTime?
  grantedById    String?
  purchaseId     String?
  purchase       Purchase?         @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  subscriptionId String?
  subscription   Subscription?     @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([userId])
  @@index([userId, status])
  @@index([paperId])
  @@index([mockExamId])
}

model Certificate {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  attemptId   String   @unique
  attempt     QuizAttempt @relation(fields: [attemptId], references: [id])
  // TODO Phase 3: PDF generation + R2 storage URL
  fileUrl     String?
  issuedAt    DateTime @default(now())
}
